# ─────────────────────────────────────────────────────────────────
# Galaxy Ride — Environment Variables
# Copy this file to .env for local dev (never commit .env)
# Set all these in Netlify → Site Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Firebase Frontend (safe to use in browser — hardcoded in firebase.js) ──
FIREBASE_API_KEY=AIzaSyBcmBnSMiMJui28q9AlBvoVVHH6wmbgm_c
FIREBASE_AUTH_DOMAIN=galaxyride-4f219.firebaseapp.com
FIREBASE_PROJECT_ID=galaxyride-4f219
FIREBASE_STORAGE_BUCKET=galaxyride-4f219.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=351465763874
FIREBASE_APP_ID=1:351465763874:web:e2f89a58a686661566467b

# ── Firebase Admin (BACKEND ONLY — Netlify Functions) ────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=galaxyride-4f219
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@galaxyride-4f219.iam.gserviceaccount.com
# Paste the private_key value — keep the \n characters (single line, with quotes)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Razorpay ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys.  LIVE keys start with rzp_live_
# The Key ID is publishable (sent to browser via /api/create-order).
# The Key Secret is private and must stay server-side only.
# NOTE: never put real keys here — this file is committed. Put them in .env only.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_secret_here
