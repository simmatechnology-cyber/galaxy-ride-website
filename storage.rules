rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Galaxy Ride — Firebase Storage Security Rules
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    // Driver document uploads (website registration + driver app KYC).
    // Storage folder is always the authenticated user's UID so the rule
    // can verify ownership.  Website uses currentUser.uid; driver app
    // uses its own auth.uid — both are covered by the same rule.
    match /driver-documents/{driverId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == driverId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      // getDownloadURL() tokens bypass rules, so admin download links always work.
      allow read:  if request.auth != null
                   && (request.auth.uid == driverId
                       || request.auth.token.admin == true);
    }

    // Everything else: locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
