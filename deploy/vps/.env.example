# Galaxy Ride — VPS production environment variables
# Copy this to ".env" in /home/galaxyride/public_html on the SERVER ONLY.
# NEVER commit a real .env file, and NEVER paste these values into any
# web form/GUI field — create this file directly via SSH (e.g. `nano .env`).
# chmod 600 .env after creating it.

NODE_ENV=production
PORT=5000

# Razorpay LIVE keys (from the Razorpay dashboard → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin SDK service account (from Firebase Console →
# Project Settings → Service Accounts → Generate new private key).
# FIREBASE_PRIVATE_KEY must keep its \n sequences literal (one line,
# quoted) — _firebase-admin.js converts them back to real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
