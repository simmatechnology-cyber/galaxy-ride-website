rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Galaxy Ride — Firestore Security Rules
//  Last updated: 2026-07-01
// ─────────────────────────────────────────────────────────────
//
//  Admin identity:
//    Document-based: admins/{uid} with isActive == true grants admin access.
//    The admin app creates/manages the admins collection.
//    To add an admin: create Firestore doc  admins/{uid}  with
//    fields  { isActive: true, role: "super_admin", ... }
//
//  Collections covered:
//    Customer website:   users, bookings, trip_requests, stats, driverApplications,
//                        travelRedirectAnalytics, contact_messages, payment_failures
//    Admin app:          admins, drivers, vendors, vehicles, subscriptions,
//                        wallets, walletTransactions, tripBids, fakeTrips,
//                        notifications, payments, analytics, temporaryDrivers,
//                        activityFeed
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Admin check via Firestore document (no custom Auth claim required).
    // Reads the admins/{uid} doc to verify isActive == true.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActiveAdmin() {
      return isAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
    function isSuperAdmin() {
      return isActiveAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Fields allowed on a new trip request (prevents status/driver spoofing)
    function validTripCreate() {
      let allowed = [
        'tripId','customerName','customerPhone','customerEmail',
        'pickup','pickupAddress','pickupLat','pickupLng',
        'drop','dropAddress','dropLat','dropLng',
        'tripType','vehicleType','date','time',
        'passengers','estimatedFare','fare','paymentMethod','paymentStatus',
        'distanceKm','createdAt','status','driverId','driverName'
      ];
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ── ADMINS ────────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read:   if request.auth.uid == adminId && isActiveAdmin();
      allow write:  if isSuperAdmin();
      allow update: if request.auth.uid == adminId &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastLogin', 'fcmToken', 'fcmTokenUpdatedAt']);
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid) || isActiveAdmin();
      allow write: if isOwner(uid);

      match /bookings/{bookingId} {
        allow read:  if isOwner(uid) || isActiveAdmin();
        allow write: if isOwner(uid);
        allow delete: if false;
      }
    }

    // ── BOOKINGS ──────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Customer creates their own booking; unauthenticated guests also allowed
      // (guest checkout) — admin app can always create/read/write.
      allow create: if true;
      allow read:   if isActiveAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isActiveAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ── TRIP REQUESTS ─────────────────────────────────────────────────────────
    // Admin dispatch board — customer website writes here after booking.
    // Collection name: trip_requests  (snake_case, matches customer website JS)
    match /trip_requests/{tripId} {
      allow create: if isSignedIn() && validTripCreate();
      allow read:   if isActiveAdmin()
                    || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow update: if isActiveAdmin()
                    || (isSignedIn()
                        && resource.data.driverId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                                           .hasOnly(['status', 'updatedAt']));
      allow delete: if false;
    }

    // ── TRIP BIDS ─────────────────────────────────────────────────────────────
    match /tripBids/{bidId} {
      allow read:   if isActiveAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── DRIVERS ──────────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read:   if isOwner(driverId) || isActiveAdmin();
      allow create: if isSignedIn();
      allow update: if isActiveAdmin()
                    || (isOwner(driverId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                                           .hasOnly(['status', 'updatedAt', 'onlineStatus', 'location']));
      allow delete: if false;
    }

    // ── DRIVER APPLICATIONS ───────────────────────────────────────────────────
    match /driverApplications/{appId} {
      allow create: if request.resource.data.status == 'pending';
      allow read:   if isActiveAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // ── VENDORS ──────────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read:   if isActiveAdmin();
      allow create: if isSignedIn();
      allow update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── VEHICLES ─────────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read:   if isActiveAdmin() || isSignedIn();
      allow write:  if isActiveAdmin();
    }

    // ── SUBSCRIPTIONS ─────────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read:   if isActiveAdmin()
                    || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow write:  if isActiveAdmin();
    }

    // ── WALLETS ───────────────────────────────────────────────────────────────
    match /wallets/{walletId} {
      allow read:   if isActiveAdmin() || isOwner(walletId);
      allow write:  if isActiveAdmin();
    }

    match /walletTransactions/{txId} {
      allow read:   if isActiveAdmin()
                    || (isSignedIn() && resource.data.driverId == request.auth.uid)
                    || (isSignedIn() && resource.data.userId   == request.auth.uid);
      allow write:  if isActiveAdmin();
    }

    // ── GALAXY SMART (fakeTrips) ──────────────────────────────────────────────
    match /fakeTrips/{tripId} {
      allow read:   if isSignedIn();
      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
      // Drivers can increment attemptCount
      allow update: if isSignedIn() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['attemptCount']);
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if isActiveAdmin();
      allow create: if true;
    }

    // ── PAYMENTS ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:  if isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // ── ANALYTICS ────────────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read, write: if isActiveAdmin();
    }

    // ── STATS ─────────────────────────────────────────────────────────────────
    match /stats/{doc} {
      allow read:   if isActiveAdmin();
      allow write:  if isSignedIn();
      allow delete: if false;
    }

    // ── TEMPORARY DRIVERS ─────────────────────────────────────────────────────
    match /temporaryDrivers/{driverId} {
      allow read, write: if isActiveAdmin();
    }

    // ── ACTIVITY FEED ─────────────────────────────────────────────────────────
    match /activityFeed/{itemId} {
      allow read: if isActiveAdmin();
      allow write: if true;
    }

    // ── TRAVEL REDIRECT ANALYTICS ─────────────────────────────────────────────
    match /travelRedirectAnalytics/{id} {
      allow create: if true;
      allow read:   if isActiveAdmin();
      allow update, delete: if false;
    }

    // ── CONTACT MESSAGES ──────────────────────────────────────────────────────
    match /contact_messages/{id} {
      allow create: if request.resource.data.status == 'new';
      allow read:   if isActiveAdmin();
      allow update, delete: if false;
    }

    // ── PAYMENT FAILURES (internal log) ──────────────────────────────────────
    // Written only via Firebase Admin SDK (bypasses rules). Clients: no access.
    match /payment_failures/{id} {
      allow read, write: if false;
    }

  }
}
